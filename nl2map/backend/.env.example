# 复制本文件为 .env 并填写真实值；.env 不会被提交到仓库
# 模型服务地址（OpenAI 兼容格式，以 /v1 结尾）
MODEL_BASE_URL=http://your-server:8000/v1
# 模型服务的 API Key
MODEL_API_KEY=sk-xxxx
# 模型名称
MODEL_NAME=your-model-name

# 真实地图：低频本地研究服务，可替换为自建 Photon / Overpass；不使用公共 Nominatim。
# auto：配置高德 Key 时使用高德，否则沿用 Photon；amap：缺少 Key 时明确报错。
MAP_GEOCODER_PROVIDER=auto
# 高德开放平台 Web 服务 Key，需具备地理编码和 POI 搜索权限。
AMAP_WEB_API_KEY=
# 可选城市名或行政区划代码，用于约束高德查询；留空时按输入地址查询。
MAP_AMAP_CITY=
MAP_PHOTON_URL=https://photon.komoot.io/api/
MAP_OVERPASS_URL=https://overpass-api.de/api/interpreter
MAP_USER_AGENT=SimHarness-NL2MAP/0.3 (local research demo)
MAP_DEFAULT_RADIUS_M=1000
MAP_MAX_RADIUS_M=3000
MAP_REQUEST_TIMEOUT_SEC=75
MAP_CACHE_TTL_SEC=86400
MAP_MAX_RESPONSE_BYTES=33554432
MAP_TOOL_TIMEOUT_SEC=90

# 仿真场景缺省参数；文字中的明确参数优先。
SCENARIO_DURATION_S=600
SCENARIO_SEED=42
# 仅无显式车辆数/流量/密度时缩减默认发车强度，1 恢复原推算量。
SCENARIO_DEFAULT_DEMAND_SCALE=0.1
SCENARIO_RUN_TIMEOUT_S=120
