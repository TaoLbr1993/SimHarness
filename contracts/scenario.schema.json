{
  "$defs": {
    "AutomationConfig": {
      "additionalProperties": false,
      "properties": {
        "proportions": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/AutomationLevel"
          },
          "title": "Proportions",
          "type": "object"
        }
      },
      "required": [
        "proportions"
      ],
      "title": "AutomationConfig",
      "type": "object"
    },
    "AutomationLevel": {
      "enum": [
        "HUMAN",
        "ACC",
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "title": "AutomationLevel",
      "type": "string"
    },
    "CarlaConfig": {
      "additionalProperties": false,
      "properties": {
        "blueprint_filter": {
          "default": "vehicle.*",
          "minLength": 1,
          "title": "Blueprint Filter",
          "type": "string"
        },
        "endpoint_mode": {
          "const": "local_server",
          "default": "local_server",
          "title": "Endpoint Mode",
          "type": "string"
        },
        "expected_version": {
          "minLength": 1,
          "title": "Expected Version",
          "type": "string"
        },
        "fallback_blueprints": {
          "default": [
            "vehicle.tesla.model3",
            "vehicle.audi.tt"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fallback Blueprints",
          "type": "array"
        },
        "host": {
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RequirementMode"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "spawn_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Spawn Retries",
          "type": "integer"
        },
        "step_ms": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Step Ms",
          "type": "integer"
        },
        "timeout_s": {
          "exclusiveMinimum": 0.0,
          "title": "Timeout S",
          "type": "number"
        },
        "worker_threads": {
          "default": 0,
          "minimum": 0,
          "title": "Worker Threads",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "host",
        "port",
        "timeout_s",
        "expected_version"
      ],
      "title": "CarlaConfig",
      "type": "object"
    },
    "CarlaViewConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "native_window",
          "default": "native_window",
          "title": "Mode",
          "type": "string"
        },
        "native_window_id_env": {
          "default": "TRAFFICVERSE_CARLA_WINDOW_ID",
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Native Window Id Env",
          "type": "string"
        }
      },
      "title": "CarlaViewConfig",
      "type": "object"
    },
    "HighwayEnvConfig": {
      "additionalProperties": false,
      "description": "Reproducible highway scenarios, with bounded, typed SDK settings.",
      "properties": {
        "controlled_vehicles": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Controlled Vehicles",
          "type": "integer"
        },
        "duration_ms": {
          "default": 40000,
          "exclusiveMinimum": 0,
          "maximum": 3600000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "environment_id": {
          "const": "highway-v0",
          "default": "highway-v0",
          "title": "Environment Id",
          "type": "string"
        },
        "initial_lane_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Lane Id"
        },
        "lanes_count": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Lanes Count",
          "type": "integer"
        },
        "policy_frequency": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Policy Frequency",
          "type": "integer"
        },
        "provider": {
          "const": "highway",
          "default": "highway",
          "title": "Provider",
          "type": "string"
        },
        "seed": {
          "default": 42,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "shared_scene": {
          "anyOf": [
            {
              "$ref": "#/$defs/SharedScene"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "simulation_frequency": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Simulation Frequency",
          "type": "integer"
        },
        "vehicles_count": {
          "default": 30,
          "maximum": 500,
          "minimum": 0,
          "title": "Vehicles Count",
          "type": "integer"
        }
      },
      "title": "HighwayEnvConfig",
      "type": "object"
    },
    "LoggingConfig": {
      "additionalProperties": false,
      "properties": {
        "parquet_batch_rows": {
          "exclusiveMinimum": 0,
          "title": "Parquet Batch Rows",
          "type": "integer"
        },
        "trajectory_hz": {
          "exclusiveMinimum": 0,
          "title": "Trajectory Hz",
          "type": "integer"
        }
      },
      "required": [
        "trajectory_hz",
        "parquet_batch_rows"
      ],
      "title": "LoggingConfig",
      "type": "object"
    },
    "MapRegistrationConfig": {
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "minLength": 1,
          "title": "Manifest",
          "type": "string"
        }
      },
      "required": [
        "manifest"
      ],
      "title": "MapRegistrationConfig",
      "type": "object"
    },
    "ReplayConfig": {
      "additionalProperties": false,
      "properties": {
        "snapshot_interval_ms": {
          "exclusiveMinimum": 0,
          "title": "Snapshot Interval Ms",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_interval_ms"
      ],
      "title": "ReplayConfig",
      "type": "object"
    },
    "RequirementMode": {
      "enum": [
        "required",
        "optional",
        "disabled"
      ],
      "title": "RequirementMode",
      "type": "string"
    },
    "RoiConfig": {
      "additionalProperties": false,
      "properties": {
        "buffer_m": {
          "exclusiveMinimum": 0.0,
          "title": "Buffer M",
          "type": "number"
        },
        "focus": {
          "$ref": "#/$defs/RoiFocusConfig"
        },
        "max_actors": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Max Actors",
          "type": "integer"
        },
        "radius_m": {
          "exclusiveMinimum": 0.0,
          "title": "Radius M",
          "type": "number"
        }
      },
      "required": [
        "radius_m",
        "buffer_m",
        "focus"
      ],
      "title": "RoiConfig",
      "type": "object"
    },
    "RoiFocusConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "follow_vehicle"
          ],
          "title": "Mode",
          "type": "string"
        },
        "vehicle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicle Id"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "mode"
      ],
      "title": "RoiFocusConfig",
      "type": "object"
    },
    "ScenarioIdentityConfig": {
      "additionalProperties": false,
      "properties": {
        "map_id": {
          "minLength": 1,
          "title": "Map Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "map_id",
        "seed"
      ],
      "title": "ScenarioIdentityConfig",
      "type": "object"
    },
    "SceneConnection": {
      "additionalProperties": false,
      "properties": {
        "signal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal Id"
        },
        "signal_index": {
          "default": 0,
          "minimum": 0,
          "title": "Signal Index",
          "type": "integer"
        },
        "source_lane": {
          "title": "Source Lane",
          "type": "string"
        },
        "target_lane": {
          "title": "Target Lane",
          "type": "string"
        },
        "via_lane": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via Lane"
        }
      },
      "required": [
        "source_lane",
        "target_lane"
      ],
      "title": "SceneConnection",
      "type": "object"
    },
    "SceneLane": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "lane_id": {
          "title": "Lane Id",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "speed_mps": {
          "default": 30,
          "title": "Speed Mps",
          "type": "number"
        },
        "width_m": {
          "default": 3.2,
          "exclusiveMinimum": 0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "lane_id",
        "edge_id",
        "points"
      ],
      "title": "SceneLane",
      "type": "object"
    },
    "SceneSignal": {
      "additionalProperties": false,
      "properties": {
        "offset_s": {
          "default": 0,
          "title": "Offset S",
          "type": "number"
        },
        "phases": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Phases",
          "type": "array"
        },
        "signal_id": {
          "title": "Signal Id",
          "type": "string"
        }
      },
      "required": [
        "signal_id",
        "phases"
      ],
      "title": "SceneSignal",
      "type": "object"
    },
    "SceneStop": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "default": 0,
          "title": "Duration S",
          "type": "number"
        },
        "lane_id": {
          "title": "Lane Id",
          "type": "string"
        },
        "position_m": {
          "title": "Position M",
          "type": "number"
        },
        "until_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until S"
        }
      },
      "required": [
        "lane_id",
        "position_m"
      ],
      "title": "SceneStop",
      "type": "object"
    },
    "SceneVehicle": {
      "additionalProperties": false,
      "properties": {
        "acceleration_mps2": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Acceleration Mps2",
          "type": "number"
        },
        "deceleration_mps2": {
          "default": 4.5,
          "exclusiveMinimum": 0,
          "title": "Deceleration Mps2",
          "type": "number"
        },
        "depart_lane": {
          "default": "best",
          "title": "Depart Lane",
          "type": "string"
        },
        "depart_position_m": {
          "default": 0,
          "title": "Depart Position M",
          "type": "number"
        },
        "depart_s": {
          "title": "Depart S",
          "type": "number"
        },
        "depart_speed": {
          "default": "0",
          "title": "Depart Speed",
          "type": "string"
        },
        "edges": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Edges",
          "type": "array"
        },
        "headway_s": {
          "default": 1.5,
          "exclusiveMinimum": 0,
          "title": "Headway S",
          "type": "number"
        },
        "length_m": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "max_speed_mps": {
          "default": 30,
          "title": "Max Speed Mps",
          "type": "number"
        },
        "min_gap_m": {
          "default": 2.5,
          "title": "Min Gap M",
          "type": "number"
        },
        "route_id": {
          "title": "Route Id",
          "type": "string"
        },
        "stops": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneStop"
          },
          "title": "Stops",
          "type": "array"
        },
        "type_id": {
          "default": "DEFAULT_VEHTYPE",
          "title": "Type Id",
          "type": "string"
        },
        "vehicle_id": {
          "title": "Vehicle Id",
          "type": "string"
        },
        "width_m": {
          "default": 1.8,
          "exclusiveMinimum": 0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "vehicle_id",
        "route_id",
        "edges",
        "depart_s"
      ],
      "title": "SceneVehicle",
      "type": "object"
    },
    "SharedScene": {
      "additionalProperties": false,
      "properties": {
        "begin_time_s": {
          "default": 0,
          "title": "Begin Time S",
          "type": "number"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/SceneConnection"
          },
          "title": "Connections",
          "type": "array"
        },
        "lanes": {
          "items": {
            "$ref": "#/$defs/SceneLane"
          },
          "title": "Lanes",
          "type": "array"
        },
        "map_id": {
          "title": "Map Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "default": 42,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "signals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneSignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "vehicles": {
          "items": {
            "$ref": "#/$defs/SceneVehicle"
          },
          "maxItems": 100000,
          "title": "Vehicles",
          "type": "array"
        }
      },
      "required": [
        "map_id",
        "lanes",
        "connections",
        "vehicles"
      ],
      "title": "SharedScene",
      "type": "object"
    },
    "SimulationConfig": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "speed_multiplier": {
          "exclusiveMinimum": 0.0,
          "title": "Speed Multiplier",
          "type": "number"
        },
        "start_time_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Start Time Ms",
          "type": "integer"
        },
        "step_ms": {
          "exclusiveMinimum": 0,
          "title": "Step Ms",
          "type": "integer"
        }
      },
      "required": [
        "step_ms",
        "duration_ms",
        "speed_multiplier"
      ],
      "title": "SimulationConfig",
      "type": "object"
    },
    "SumoConfig": {
      "additionalProperties": false,
      "description": "SUMO/TraCI endpoint or managed local process used as the traffic truth source.",
      "properties": {
        "begin_time_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Begin Time Ms",
          "type": "integer"
        },
        "binary": {
          "default": "sumo",
          "minLength": 1,
          "title": "Binary",
          "type": "string"
        },
        "config_file": {
          "minLength": 1,
          "title": "Config File",
          "type": "string"
        },
        "connect_retries": {
          "default": 3,
          "maximum": 100,
          "minimum": 0,
          "title": "Connect Retries",
          "type": "integer"
        },
        "expected_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Version"
        },
        "freeze_collisions": {
          "default": false,
          "title": "Freeze Collisions",
          "type": "boolean"
        },
        "host": {
          "default": "127.0.0.1",
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "launch_mode": {
          "default": "external",
          "enum": [
            "external",
            "managed"
          ],
          "title": "Launch Mode",
          "type": "string"
        },
        "output_directory": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Directory"
        },
        "port": {
          "default": 8813,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "provider": {
          "const": "sumo",
          "default": "sumo",
          "title": "Provider",
          "type": "string"
        },
        "step_ms": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Step Ms",
          "type": "integer"
        },
        "tls_manager": {
          "const": "sumo",
          "default": "sumo",
          "title": "Tls Manager",
          "type": "string"
        }
      },
      "required": [
        "config_file"
      ],
      "title": "SumoConfig",
      "type": "object"
    },
    "TrafficConfig": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "minLength": 1,
          "title": "Network",
          "type": "string"
        },
        "routes": {
          "minLength": 1,
          "title": "Routes",
          "type": "string"
        },
        "signals": {
          "minLength": 1,
          "title": "Signals",
          "type": "string"
        },
        "vehicles": {
          "exclusiveMinimum": 0,
          "title": "Vehicles",
          "type": "integer"
        }
      },
      "required": [
        "network",
        "routes",
        "signals",
        "vehicles"
      ],
      "title": "TrafficConfig",
      "type": "object"
    },
    "UiConfig": {
      "additionalProperties": false,
      "properties": {
        "api_url": {
          "default": "http://127.0.0.1:8000",
          "minLength": 1,
          "title": "Api Url",
          "type": "string"
        },
        "carla_view": {
          "$ref": "#/$defs/CarlaViewConfig"
        }
      },
      "title": "UiConfig",
      "type": "object"
    },
    "WeatherConfig": {
      "additionalProperties": false,
      "properties": {
        "preset": {
          "minLength": 1,
          "title": "Preset",
          "type": "string"
        }
      },
      "required": [
        "preset"
      ],
      "title": "WeatherConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automation": {
      "$ref": "#/$defs/AutomationConfig"
    },
    "carla": {
      "$ref": "#/$defs/CarlaConfig"
    },
    "highway": {
      "anyOf": [
        {
          "$ref": "#/$defs/HighwayEnvConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "logging": {
      "$ref": "#/$defs/LoggingConfig"
    },
    "map_registration": {
      "$ref": "#/$defs/MapRegistrationConfig"
    },
    "replay": {
      "$ref": "#/$defs/ReplayConfig"
    },
    "roi": {
      "$ref": "#/$defs/RoiConfig"
    },
    "scenario": {
      "$ref": "#/$defs/ScenarioIdentityConfig"
    },
    "schema_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation": {
      "$ref": "#/$defs/SimulationConfig"
    },
    "sumo": {
      "$ref": "#/$defs/SumoConfig"
    },
    "traffic": {
      "$ref": "#/$defs/TrafficConfig"
    },
    "ui": {
      "$ref": "#/$defs/UiConfig"
    },
    "weather": {
      "$ref": "#/$defs/WeatherConfig"
    }
  },
  "required": [
    "scenario",
    "simulation",
    "traffic",
    "sumo",
    "automation",
    "roi",
    "carla",
    "weather",
    "map_registration",
    "logging",
    "replay"
  ],
  "title": "ScenarioConfig",
  "type": "object"
}
